COMPOSE_PROJECT_NAME=gestion_plantas
APP_PORT=8080

# Para probar en el mismo computador. En el VPS utiliza tu dominio HTTPS.
APP_URL=http://localhost:8080
APP_KEY=
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080
# Válido para este stack: PHP-FPM privado y única entrada HTTP en localhost.
TRUSTED_PROXIES=*

DB_DATABASE=gestion_plantas
DB_USERNAME=gestion_app
# Genera dos contraseñas distintas antes de ejecutar Docker Compose.
POSTGRES_ADMIN_PASSWORD=
DB_PASSWORD=
